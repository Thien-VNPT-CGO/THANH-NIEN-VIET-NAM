{
  "name": "chi-doan-so-6.0",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ sinh thái Chi đoàn số 6.0 — Xã Tân Hòa (Google Sheets + Apps Script)",
  "scripts": {
    "build": "node build.js",
    "check": "node tools/check-gas.js",
    "ci": "npm run check && npm test",
    "test": "node tests/parity.test.js && node tests/api.test.js && node tests/ui.test.js",
    "test:parity": "node tests/parity.test.js",
    "test:api": "node tests/api.test.js",
    "test:ui": "node tests/ui.test.js",
    "test:e2e": "playwright test --config=e2e/playwright.config.js",
    "e2e:install": "playwright install chromium",
    "preview": "npx --yes serve web"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3"
  },
  "engines": {
    "node": ">=18"
  }
}
